DATABASE_URL="postgresql://bookkeeper:bookkeeper@localhost:5432/bookkeeper"
AUTH_SECRET="local-dev-secret-change-in-production"
AUTH_URL="http://localhost:3000"
BACKDOOR_USERNAME="ron"

# Railway production:
# 1. Add a PostgreSQL database in your Railway project
# 2. Link it to the web service — Railway sets DATABASE_URL automatically
# 3. Do NOT use SQLite (file:...) in production; it is wiped on every deploy
